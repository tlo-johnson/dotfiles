#compdef j

_j_pair_aliases() {
  local -a completions
  local aliases_file="${HOME}/.config/jj-pair/aliases"
  if [[ -f "$aliases_file" ]]; then
    while IFS='=' read -r key value; do
      completions+=("${key}:${value}")
    done < "$aliases_file"
  fi
  _describe 'pair alias' completions
}

_j_bookmarks() {
  local -a bookmarks
  bookmarks=(${(f)"$(jj bookmark list -T 'name ++ "\n"' 2>/dev/null)"})
  _describe 'bookmark' bookmarks
}

_j() {
  if [[ "${words[2]}" == "m" ]]; then
    _arguments \
      '--pair[Co-author alias]:alias:_j_pair_aliases' \
      '--pair-alias[Create new alias (alias=Name <email>)]:definition:' \
      ':commit message:'
  elif [[ "${words[2]}" == "ps" ]]; then
    _arguments \
      '--bookmark[Bookmark to create/update and push]:bookmark:_j_bookmarks' \
      '::'
  else
    words[1]='jj'
    _jj
  fi
}

_j "$@"
